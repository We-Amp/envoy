+#define GUARD_NAMELEN 10
+#define GUARD_VALUELEN 62
+/* entry_room() of one guard header field */
+#define GUARD_ROOM (NGHTTP2_HD_ENTRY_OVERHEAD + GUARD_NAMELEN + GUARD_VALUELEN)
+#define GUARD_MAX_NV 52
+
+typedef struct {
+  nghttp2_nv nva[GUARD_MAX_NV];
+  uint8_t names[GUARD_MAX_NV][GUARD_NAMELEN + 1];
+  uint8_t values[GUARD_MAX_NV][GUARD_VALUELEN];
+  size_t nvlen;
+} guard_nva;
+
+/* Makes |n| distinct header fields "x-<set>-hdr-NN" whose table entry
+   size is GUARD_ROOM each. */
+static void guard_nva_init(guard_nva *g, char set, size_t n) {
+  size_t i;
+
+  assert(n <= GUARD_MAX_NV);
+
+  for (i = 0; i < n; ++i) {
+    snprintf((char *)g->names[i], sizeof(g->names[i]), "x-%c-hdr-%02u", set,
+             (unsigned int)i);
+    memset(g->values[i], 'a' + (int)(i % 26), GUARD_VALUELEN);
+
+    g->nva[i].name = g->names[i];
+    g->nva[i].namelen = GUARD_NAMELEN;
+    g->nva[i].value = g->values[i];
+    g->nva[i].valuelen = GUARD_VALUELEN;
+    g->nva[i].flags = NGHTTP2_NV_FLAG_NONE;
+  }
+
+  g->nvlen = n;
+}
+
+/* Deflates |g| as one header block, checks that |inflater| decodes
+   it back, and returns the length of the block. */
+static nghttp2_ssize guard_round_trip(nghttp2_hd_deflater *deflater,
+                                      nghttp2_hd_inflater *inflater,
+                                      guard_nva *g, nghttp2_mem *mem) {
+  nghttp2_bufs bufs;
+  nghttp2_ssize blocklen;
+  nva_out out;
+  int rv;
 
+  frame_pack_bufs_init(&bufs);
+  nva_out_init(&out);
+
+  rv = nghttp2_hd_deflate_hd_bufs(deflater, &bufs, g->nva, g->nvlen);
+  blocklen = (nghttp2_ssize)nghttp2_bufs_len(&bufs);
+
+  assert_int(0, ==, rv);
+  assert_ptrdiff(0, <, blocklen);
+  assert_ptrdiff(blocklen, ==, inflate_hd(inflater, &out, &bufs, 0, mem));
+
+  assert_size(g->nvlen, ==, out.nvlen);
+  assert_nv_equal(g->nva, out.nva, g->nvlen, mem);
+
+  nva_out_reset(&out, mem);
   nghttp2_bufs_free(&bufs);
+
+  return blocklen;
+}
+
+void test_nghttp2_hd_deflate_self_eviction_guard(void) {
+  nghttp2_hd_deflater deflater;
+  nghttp2_hd_inflater inflater;
+  guard_nva big, other, a, b;
+  nghttp2_ssize len1, len2, len3, len4;
+  const nghttp2_nv *ent;
+  size_t fit;
+  size_t i;
+  nghttp2_mem *mem;
+
+  mem = nghttp2_mem_default();
+
+  /* The number of guard entries a 4096 byte table holds: 39 */
+  fit = 4096 / GUARD_ROOM;
+  assert_size(39, ==, fit);
+
+  /* A constant header block larger than the dynamic table.  Without
+     the guard, every field evicts a field the previous block
+     inserted and nothing is ever found in the table. */
+  guard_nva_init(&big, 'a', GUARD_MAX_NV);
+
+  nghttp2_hd_deflate_init(&deflater, mem);
+  nghttp2_hd_inflate_init(&inflater, mem);
+
+  len1 = guard_round_trip(&deflater, &inflater, &big, mem);
+
+  /* The first 39 fields are indexed; the rest would evict them and
+     are sent as literal without indexing. */
+  assert_size(fit, ==, deflater.ctx.hd_table.len);
+  ent = nghttp2_hd_deflate_get_table_entry(&deflater,
+                                           NGHTTP2_STATIC_TABLE_LENGTH + 1);
+  assert_not_null(ent);
+  assert_memory_equal(GUARD_NAMELEN, big.nva[fit - 1].name, ent->name);
+
+  len2 = guard_round_trip(&deflater, &inflater, &big, mem);
+  len3 = guard_round_trip(&deflater, &inflater, &big, mem);
+
+  /* The 39 resident fields are 1 byte index representations now. */
+  assert_ptrdiff(len2 * 2, <, len1);
+  assert_ptrdiff(len2, ==, len3);
+  assert_size(fit, ==, deflater.ctx.hd_table.len);
+  assert_size(fit, ==, inflater.ctx.hd_table.len);
+
+  /* Shrink the table mid-stream.  The deflater emits a table size
+     update, the decoder follows, and the guard works against the new
+     size. */
+  assert_int(0, ==, nghttp2_hd_inflate_change_table_size(&inflater, 2048));
+  assert_int(0, ==, nghttp2_hd_deflate_change_table_size(&deflater, 2048));
+
+  len1 = guard_round_trip(&deflater, &inflater, &big, mem);
+  assert_size(2048 / GUARD_ROOM, ==, deflater.ctx.hd_table.len);
+  len2 = guard_round_trip(&deflater, &inflater, &big, mem);
+  len3 = guard_round_trip(&deflater, &inflater, &big, mem);
+  assert_ptrdiff(len2, ==, len3);
+  assert_size(2048 / GUARD_ROOM, ==, deflater.ctx.hd_table.len);
+  assert_size(2048 / GUARD_ROOM, ==, inflater.ctx.hd_table.len);
+
+  /* Grow it back.  The free room is filled again. */
+  assert_int(0, ==, nghttp2_hd_inflate_change_table_size(&inflater, 4096));
+  assert_int(0, ==, nghttp2_hd_deflate_change_table_size(&deflater, 4096));
+
+  guard_round_trip(&deflater, &inflater, &big, mem);
+  assert_size(fit, ==, deflater.ctx.hd_table.len);
+  assert_size(fit, ==, inflater.ctx.hd_table.len);
+
+  /* The header set changes for good.  The old entries were used by
+     the previous block, so the first block of the new set is sent
+     without indexing.  After that the old entries are evicted and the
+     new set reaches the same steady state. */
+  guard_nva_init(&other, 'b', GUARD_MAX_NV);
+
+  len1 = guard_round_trip(&deflater, &inflater, &other, mem);
+  len2 = guard_round_trip(&deflater, &inflater, &other, mem);
+  len3 = guard_round_trip(&deflater, &inflater, &other, mem);
+  len4 = guard_round_trip(&deflater, &inflater, &other, mem);
+
+  assert_ptrdiff(len3 * 2, <, len1);
+  assert_ptrdiff(len3, ==, len4);
+  for (i = 0; i < fit; ++i) {
+    ent = nghttp2_hd_deflate_get_table_entry(
+      &deflater, NGHTTP2_STATIC_TABLE_LENGTH + 1 + i);
+    assert_not_null(ent);
+    assert_memory_equal(GUARD_NAMELEN, other.nva[fit - 1 - i].name,
+                        ent->name);
+  }
+
+  nghttp2_hd_inflate_free(&inflater);
+  nghttp2_hd_deflate_free(&deflater);
+
+  /* Two disjoint header sets alternating on one connection.  Each
+     fits in the table alone, but not both.  One set stays resident
+     and is fully indexed. */
+  guard_nva_init(&a, 'c', 30);
+  guard_nva_init(&b, 'd', 30);
+
+  nghttp2_hd_deflate_init(&deflater, mem);
+  nghttp2_hd_inflate_init(&inflater, mem);
+
+  guard_round_trip(&deflater, &inflater, &a, mem);
+  len1 = guard_round_trip(&deflater, &inflater, &b, mem);
+
+  for (i = 0; i < 4; ++i) {
+    /* Every field of a is a 1 byte index representation. */
+    assert_ptrdiff(30, ==, guard_round_trip(&deflater, &inflater, &a, mem));
+    len2 = guard_round_trip(&deflater, &inflater, &b, mem);
+    /* The part of b which fitted the first time is still indexed. */
+    assert_ptrdiff(len2, <, len1);
+  }
+
+  assert_size(fit, ==, deflater.ctx.hd_table.len);
+
   nghttp2_hd_inflate_free(&inflater);
   nghttp2_hd_deflate_free(&deflater);
 }
