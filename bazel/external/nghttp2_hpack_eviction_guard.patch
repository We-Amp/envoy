+/*
+ * Returns nonzero if making room for a new entry of |room| bytes in
+ * the dynamic table would evict an entry which was inserted or
+ * referenced while encoding the current or the previous header
+ * block.  Evicting such an entry is likely to cost more than
+ * indexing the new one gains: when a header block is larger than the
+ * dynamic table, inserting every field evicts the fields the
+ * previous block inserted, and no field is ever found in the table.
+ */
+static int hd_deflate_would_evict_live(nghttp2_hd_deflater *deflater,
+                                       size_t room) {
+  nghttp2_hd_context *ctx = &deflater->ctx;
+  size_t bufsize = ctx->hd_table_bufsize;
+  size_t i;
+  nghttp2_hd_entry *ent;
+
+  for (i = ctx->hd_table.len;
+       i > 0 && bufsize + room > ctx->hd_table_bufsize_max; --i) {
+    ent = hd_ringbuf_get(&ctx->hd_table, i - 1);
+    if ((uint32_t)(deflater->block_gen - ent->last_used) <= 1) {
+      return 1;
+    }
+    bufsize -= entry_room(ent->nv.name->len, ent->nv.value->len);
+  }
+
+  return 0;
+}
