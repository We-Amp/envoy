+static int hd_deflate_indexing_mode(nghttp2_hd_deflater *deflater,
+                                    const nghttp2_nv *nv, int32_t token) {
+  /* Don't index authorization header field since it may contain low
+     entropy secret data (e.g., id/password).  Also cookie header
+     field with less than 20 bytes value is also never indexed.  This
+     is the same criteria used in Firefox codebase. */
+  if (token == NGHTTP2_TOKEN_AUTHORIZATION ||
+      (token == NGHTTP2_TOKEN_COOKIE && nv->valuelen < 20) ||
+      (nv->flags & NGHTTP2_NV_FLAG_NO_INDEX)) {
+    return NGHTTP2_HD_NEVER_INDEXING;
+  }
+
+  return hd_deflate_decide_indexing(deflater, nv, token);
+}
+
+/*
+ * Returns nonzero if the header fields in |nva| which would be
+ * indexed need more room than the dynamic table has.  Only such a
+ * header block thrashes the table: each field evicts one the previous
+ * block inserted, and nothing is ever found in the table.
+ */
+static int hd_deflate_block_overflows(nghttp2_hd_deflater *deflater,
+                                      const nghttp2_nv *nva, size_t nvlen) {
+  size_t max = deflater->ctx.hd_table_bufsize_max;
+  size_t demand = 0;
+  size_t i;
+  const nghttp2_nv *nv;
+
+  /* Fast path: the block fits even if every field were indexed. */
+  for (i = 0; i < nvlen && demand <= max; ++i) {
+    demand += entry_room(nva[i].namelen, nva[i].valuelen);
+  }
+
+  if (demand <= max) {
+    return 0;
+  }
+
+  demand = 0;
+
+  for (i = 0; i < nvlen; ++i) {
+    nv = &nva[i];
+
+    if (hd_deflate_indexing_mode(deflater, nv,
+                                 lookup_token(nv->name, nv->namelen)) !=
+        NGHTTP2_HD_WITH_INDEXING) {
+      continue;
+    }
+
+    demand += entry_room(nv->namelen, nv->valuelen);
+
+    if (demand > max) {
+      return 1;
+    }
+  }
+
+  return 0;
+}
+
+/*
+ * Returns nonzero if making room for a new entry of |room| bytes in
+ * the dynamic table would evict an entry which was inserted or
+ * referenced while encoding the current or the previous header
+ * block.  Evicting such an entry is likely to cost more than
+ * indexing the new one gains: when a header block is larger than the
+ * dynamic table, inserting every field evicts the fields the
+ * previous block inserted, and no field is ever found in the table.
+ */
+static int hd_deflate_would_evict_live(nghttp2_hd_deflater *deflater,
+                                       size_t room) {
+  nghttp2_hd_context *ctx = &deflater->ctx;
+  size_t bufsize = ctx->hd_table_bufsize;
+  size_t i;
+  nghttp2_hd_entry *ent;
+
+  for (i = ctx->hd_table.len;
+       i > 0 && bufsize + room > ctx->hd_table_bufsize_max; --i) {
+    ent = hd_ringbuf_get(&ctx->hd_table, i - 1);
+    if ((uint32_t)(deflater->block_gen - ent->last_used) <= 1) {
+      return 1;
+    }
+    bufsize -= entry_room(ent->nv.name->len, ent->nv.value->len);
+  }
+
+  return 0;
+}
